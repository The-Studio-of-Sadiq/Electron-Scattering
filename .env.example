# Environment variables read by the optional Node server (npm run dev / npm start).
# Set them in your shell or hosting dashboard. The browser-only build needs none.

# "production" serves the built app from dist/; anything else runs Vite in dev mode.
NODE_ENV=development

# Allow the in-app editor to save/reset the Fortran and TypeScript sources.
# Keep this off on any server reachable by other people.
ENABLE_SOURCE_EDITING=false
